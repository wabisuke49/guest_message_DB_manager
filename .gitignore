# ログ系
logs/
*.log
# ロックファイル
*.lock
# 一時ファイル
tmp/
*.tmp
# OS固有のファイル
.DS_Store # macOS
Thumbs.db # Windows
# バックアップファイル
*~ # Emacs
*.swp # Vim
# IDE固有のファイル
.vscode/ # Visual Studio Code
.idea/ # IntelliJ系IDE
*.iml # IntelliJ系IDE
# テスト・出力結果など
tests/
coverage/
dist/
outputs/

# Python生成物
__pycache__/
*.py[cod]
.venv/

# mail_receiver のテストコードは管理する
!mail_receiver/tests/
!mail_receiver/tests/*.py

# message_analyzer のテストコードは管理する
!message_analyzer/tests/
!message_analyzer/tests/*.py
